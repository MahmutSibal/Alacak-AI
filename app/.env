MONGO_URI=mongodb://localhost:27017/alacakai
SECRET_KEY=change_me_to_strong_key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Single LLM backend (Ollama) ─────────────────────────────────────────────
# Tüm 4 persona (risk / iletişim / yapılandırma / nakit akışı) bu modele konuşur.
LLM_API_URL=http://localhost:11434
LLM_TEXT_MODEL=llama3.1:8b
# Vision/OCR şu an kullanılmıyor (manuel fatura girişi). İleride GPU sorunu
# çözüldüğünde bir VL model adı koyabilirsin (örn: qwen2.5vl:7b).
LLM_VISION_MODEL=
LLM_CTX=8192
LLM_MAX_TOKENS=1024

# ── WhatsApp microservice (Node.js + wppconnect) ────────────────────────────
# Servisi başlatmak için: cd whatsapp-service && npm install && npm start
WHATSAPP_API_URL=http://localhost:3001
WHATSAPP_API_TOKEN=alacakai_dev_2026

# ── Optional / unused ──────────────────────────────────────────────────────
OCR_SPACE_API_KEY=
GOOGLE_API_KEY= # Add your Gemini API key for invoice OCR
USE_GEMINI_VISION=true                         # Use Gemini Vision for invoice extraction
